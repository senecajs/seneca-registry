{
  "name": "@seneca/registry",
  "version": "1.0.0",
  "description": "Seneca service registry (simplistic single instance).",
  "main": "registry.js",
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-include=registry.js --test-coverage-exclude=\"test/**\" --test-coverage-lines=90 test/registry.test.js",
    "example": "node test/example.js",
    "clean-npm": "rm -rf node_modules package-lock.json",
    "repo-tag": "REPO_VERSION=`node -e \"console.log(require('./package').version)\"`; echo TAG: v$REPO_VERSION; git commit -a -m v$REPO_VERSION; git tag v$REPO_VERSION; git push --tags;",
    "repo-publish": "npm run repo-tag; npm publish --access public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senecajs/seneca-registry.git"
  },
  "keywords": [
    "seneca",
    "plugin",
    "service",
    "registry",
    "key",
    "value",
    "store"
  ],
  "author": "Richard Rodger (http://richardrodger.com)",
  "contributors": [
    "Richard Rodger (http://richardrodger.com)"
  ],
  "license": "MIT",
  "dependencies": {
    "lodash": "4"
  },
  "peerDependencies": {
    "seneca": "^4.0.0"
  },
  "devDependencies": {
    "seneca": "^4.0.0"
  },
  "files": [
    "LICENSE",
    "README.md",
    "CHANGES.md",
    "registry.js"
  ],
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
